# Cache headers for static hosts that read a _headers file (Cloudflare Pages,
# Netlify). Vercel: the same rules are in vercel.json. Other hosts: set them in their config.
#
# Security, everywhere. The page's own CSP is a <meta> tag, which cannot say
# who may frame the page (frame-ancestors) or cut a cross-origin opener's
# handle on the window (COOP): those only work as headers.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin

# App code: file names carry a content hash, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The theme's files: requested with ?v=<version>, so a new release gets a new
# URL. Its manifest (theme.json) is re-checked every time (a cheap 304): it
# names the version, so a stale one would keep players on old files. Where two
# rules match, hosts join the values, and no-cache wins over max-age.
/themes/*
  Cache-Control: public, max-age=3600
/themes/:id/theme.json
  Cache-Control: no-cache

# Famous castles (public/famous/, `npm run famous`): snapshots are requested
# with ?v=<when captured>; the list names those, so it is re-checked every time.
/famous/*
  Cache-Control: public, max-age=3600
/famous/index.json
  Cache-Control: no-cache

# The page and the service worker are always re-checked (cheap 304s), so a
# deploy shows up on the next visit.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/landing.html
  Cache-Control: no-cache
/assets.html
  Cache-Control: no-cache
/legal.html
  Cache-Control: no-cache
/app.webmanifest
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
