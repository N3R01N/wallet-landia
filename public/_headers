# Cache headers for static hosts that read a _headers file (Cloudflare Pages,
# Netlify). Other hosts: set the same rules in their own config.
#
# App code: file names carry a content hash, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Skies, theme and pack files: requested with ?v=<version>, so a new release
# gets a new URL; the lists themselves (index.json, pack.json) are re-checked
# hourly.
/env/*
  Cache-Control: public, max-age=31536000, immutable
/themes/*
  Cache-Control: public, max-age=3600
/packs/*
  Cache-Control: public, max-age=3600

# The page and the service worker are always re-checked (cheap 304s), so a
# deploy shows up on the next visit.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sandbox.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
